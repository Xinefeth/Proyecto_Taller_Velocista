# No copiar artefactos locales pesados ni secretos al contexto de build.
.git
.github
.env
*.env.local

# Python
**/__pycache__/
**/*.py[cod]
api/.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
**/*.egg-info/

# Node (se reinstala en la etapa de build)
consola/node_modules/
consola/dist/
**/*.tsbuildinfo

# Firmware / PlatformIO (no se despliega)
firmware/
**/.pio/

# Datos y docs locales
respaldos/
*.log

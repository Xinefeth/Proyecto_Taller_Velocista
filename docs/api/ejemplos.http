  "tipo_id": "linea",
  "nombre": "Pololu QTR-8A",
  "precio": 62,
  "masa_g": 3,
  "tienda": "Importación",
  "stock": 3,
  "consumo_a": 0.1,
  "especificaciones": {
    "canales": 8,
    "salida": "Analógica",
    "paso": 9.525,
    "i": 0.1
  }
}

